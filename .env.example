# Copy to .env and fill in. Never commit the real .env file.
# Free option: Get a free API key at https://console.groq.com/keys (generous free rate limit, 30 RPM)
GROQ_API_KEY=gsk_...

# Optional alternative: Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Optional model override (defaults to llama-3.3-70b-versatile for Groq):
SUPPORT_AGENT_LLM_MODEL=llama-3.3-70b-versatile
